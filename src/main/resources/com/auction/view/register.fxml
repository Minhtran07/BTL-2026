<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.RegisterController"
            prefWidth="1100" prefHeight="750"
            styleClass="root">

    <center>
        <VBox alignment="CENTER" spacing="0">
            <VBox alignment="CENTER" spacing="16" styleClass="login-panel"
                  maxWidth="450" maxHeight="650">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <Label text="Tạo tài khoản mới" styleClass="title-label"/>
                <Label text="Đăng ký để tham gia đấu giá" styleClass="subtitle-label"/>

                <Separator/>

                <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>
                <Label fx:id="successLabel" styleClass="success-label" visible="false" managed="false"/>

                <VBox spacing="6">
                    <Label text="Tên đăng nhập *"/>
                    <TextField fx:id="usernameField" promptText="Tối thiểu 3 ký tự"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Họ và tên *"/>
                    <TextField fx:id="fullNameField" promptText="Nhập họ tên đầy đủ"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Email *"/>
                    <TextField fx:id="emailField" promptText="example@email.com"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mật khẩu *"/>
                    <PasswordField fx:id="passwordField" promptText="Tối thiểu 4 ký tự"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Vai trò *"/>
                    <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Chọn vai trò"/>
                </VBox>

                <Button text="Đăng ký" onAction="#handleRegister"
                        styleClass="btn-success" maxWidth="Infinity"/>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="Đã có tài khoản?"/>
                    <Hyperlink text="Đăng nhập" onAction="#handleGoToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
