<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.EditItemController"
            prefWidth="1100" prefHeight="750"
            styleClass="root">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Quay lại" styleClass="nav-button" onAction="#handleBack"/>
            <Label text="✏ Chỉnh sửa sản phẩm"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox alignment="CENTER" spacing="0">
                <padding><Insets top="16" bottom="16"/></padding>
                <VBox styleClass="card" spacing="16" maxWidth="600">
                    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                    <Label text="Thông tin sản phẩm" styleClass="section-title"/>
                    <Separator/>

                    <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>
                    <Label fx:id="successLabel"
                           style="-fx-text-fill: #27ae60; -fx-font-size: 13px;"
                           visible="false" managed="false"/>

                    <VBox spacing="6">
                        <Label text="Tên sản phẩm *"/>
                        <TextField fx:id="itemNameField" promptText="Ví dụ: iPhone 15 Pro Max"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Danh mục"/>
                        <TextField fx:id="categoryField" editable="false"
                                   style="-fx-background-color: #f0f0f0; -fx-text-fill: #666;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Mô tả"/>
                        <TextArea fx:id="descriptionArea" promptText="Mô tả chi tiết sản phẩm..."
                                  prefRowCount="3" wrapText="true"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Giá khởi điểm (VNĐ) *"/>
                        <TextField fx:id="startPriceField" promptText="Ví dụ: 1000000"/>
                    </VBox>

                    <!-- Category-specific extra fields (populated by controller) -->
                    <VBox fx:id="extraFieldsContainer" spacing="6"/>

                    <Separator/>

                    <!-- Action buttons -->
                    <HBox spacing="12">
                        <Button text="💾 Lưu thay đổi" onAction="#handleSave"
                                styleClass="btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="🗑 Xóa sản phẩm" onAction="#handleDelete"
                                styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                    <Label text="Lưu ý: Chỉ có thể xóa sản phẩm khi chưa có phiên đấu giá đang diễn ra."
                           style="-fx-text-fill: #888; -fx-font-size: 11px;" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
