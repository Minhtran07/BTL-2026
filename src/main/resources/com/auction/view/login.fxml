<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.LoginController"
            prefWidth="1100" prefHeight="750"
            styleClass="root">

    <center>
        <VBox alignment="CENTER" spacing="0">
            <VBox alignment="CENTER" spacing="20" styleClass="login-panel"
                  maxWidth="420" maxHeight="550">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <!-- Logo / Title -->
                <Label text="🏷" style="-fx-font-size: 48px;"/>
                <Label text="Đấu giá Trực tuyến" styleClass="title-label"/>
                <Label text="Đăng nhập để bắt đầu" styleClass="subtitle-label"/>

                <Separator/>

                <!-- Error message -->
                <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>

                <!-- Login Form -->
                <VBox spacing="6">
                    <Label text="Tên đăng nhập"/>
                    <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mật khẩu"/>
                    <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"/>
                </VBox>

                <Button text="Đăng nhập" onAction="#handleLogin"
                        styleClass="btn-primary" maxWidth="Infinity"/>

                <Separator/>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="Chưa có tài khoản?"/>
                    <Hyperlink text="Đăng ký ngay" onAction="#handleGoToRegister"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
